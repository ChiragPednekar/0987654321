# ---------- Supabase ----------
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. NEVER expose to the browser. Used by seed scripts, the evaluation
# writer, and cron routes that must bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------- AI evaluation ----------
OPENAI_API_KEY=sk-...
# Any model that supports structured outputs (json_schema).
OPENAI_MODEL=gpt-4o-mini

# Optional: use Anthropic instead of OpenAI for evaluation.
# Set AI_PROVIDER=anthropic to switch.
AI_PROVIDER=openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---------- App ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret for /api/cron/* routes. Vercel Cron sends this as
# `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=generate-a-long-random-string


# ---------- Free grading options ----------
# The evaluator supports four providers via AI_PROVIDER. Pick one.
#
# 1) Gemini — genuinely free tier, recommended for getting started.
#    Key from https://aistudio.google.com/apikey
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
#
# 2) Groq — free tier, OpenAI-compatible, very fast.
#    Key from https://console.groq.com/keys
# AI_PROVIDER=openai
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=llama-3.3-70b-versatile
#
# 3) Ollama — fully local, no key, no signup, no network.
#    Install from https://ollama.com then: ollama pull llama3.1
# AI_PROVIDER=openai
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=llama3.1
#
# 4) Anthropic / OpenAI — paid, highest grading quality.

# --- Razorpay (spec §16) -----------------------------------------------------
# Without these the pricing page shows Pro as unavailable rather than a button
# that cannot charge anyone. KEY_ID is publishable; the other two are not.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# A separate secret from the API key — Razorpay signs webhooks with its own.
# Set it in the Razorpay dashboard when you add the webhook endpoint at
# /api/billing/webhook, subscribed to payment.captured and payment.failed.
RAZORPAY_WEBHOOK_SECRET=
